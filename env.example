# ==============================================================================
# Instagram Monitor Bot — .env.example
# Copy to .env and fill in. One .env per client deployment (each client gets
# their own bot token + authorized user list + this file).
# ==============================================================================

# --- Required ---------------------------------------------------------------
DISCORD_BOT_TOKEN=

# Comma-separated Discord user IDs. Append :30d / :12h / :45m for
# time-limited access (subscription expiry). No suffix = never expires.
# Example: 111111111111111111:30d,222222222222222222
AUTHORIZED_USER_IDS=

# Upstash Redis (free tier) — required for data to survive restarts/redeploys
# on Render's free plan (no persistent disk available there). Get these from
# your Upstash database's "REST API" tab. If left blank, the bot falls back
# to local JSON files, which reset on every Render free-tier redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional (defaults shown) ----------------------------------------------
POLL_INTERVAL_SECONDS=300
API_TIMEOUT_SECONDS=20
CONFIRMATION_THRESHOLD=2
PORT=8080

DATA_FILE=monitored_accounts.json
CHANNEL_CONFIG_FILE=channel_config.json
CARDS_DIR=cards

# --- Advanced tier only (ignored by bot_basic.py) ---------------------------
# Custom/premium emoji strings, e.g. <:verified:123456789012345678>.
# Leave unset to use plain unicode emoji - no Nitro or custom emoji setup
# required for the bot to work.
EMOJI_VERIFIED=
EMOJI_TROPHY=
EMOJI_CLOCK=
EMOJI_SKULL=
EMOJI_GRAVE=
EMOJI_WARNING=

BOT_FOOTER_TEXT=Instagram Monitor — Premium Monitoring
